      "parameters": {
        "jsCode": "// Why Code: случайный пин-код из криптографического генератора, ни один узел n8n такого не делает.\nconst a = new Uint32Array(1);\ncrypto.getRandomValues(a);\nconst pin = String(100000 + (a[0] % 900000));\nreturn [{ json: { ...$input.first().json, pin } }];"
