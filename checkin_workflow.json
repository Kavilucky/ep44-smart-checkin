        "query": "WITH c AS (INSERT INTO consents (chat_id, offer_version) VALUES ($1, 'v1') RETURNING chat_id) SELECT g.chat_id, COALESCE(g.checkout_at, now() + interval '1 day') AS valid_until FROM guests g JOIN c ON c.chat_id = g.chat_id;",
